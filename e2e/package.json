{
  "name": "showroom-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Outside-in Playwright browser tests for the showroom Podman stack",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:install": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
